COMMANDS = ("start", "setup", "shell", "justin", "status", "list", "ls", "add", "rm",
            "set", "pkg", "scan", "edit", "script", "menu", "help", "new", "rebuild")


def build_parser():
    parser = argparse.ArgumentParser(prog="dunenv", add_help=False)
    sub = parser.add_subparsers(dest="cmd")

    def setup_options(p):
        p.add_argument("words", nargs="*", help="environment name and/or 'build'")
        p.add_argument("-v", "--version", help="dunesw version")
        p.add_argument("-q", "--qualifier", "--qual", help="dunesw qualifier, e.g. e26:prof")
        p.add_argument("-p", "--pkg", action="append", default=[], help='extra UPS product: "name ver -q qual"')
        p.add_argument("--grid", dest="grid", action="store_true", default=None)
        p.add_argument("--no-grid", dest="grid", action="store_false")
        p.add_argument("--dev", action="store_true", help="run mrbsetenv before mrbslp")
        p.add_argument("--build", action="store_true", help="build container")
        p.add_argument("-n", "--dry-run", action="store_true")

    for name, func in (("start", cmd_start), ("setup", cmd_setup), ("script", cmd_script)):
        p = sub.add_parser(name)
        setup_options(p)
        p.set_defaults(func=func)

    p = sub.add_parser("shell")
    p.add_argument("words", nargs="*")
    p.add_argument("--build", action="store_true")
    p.add_argument("-n", "--dry-run", action="store_true")
    p.set_defaults(func=cmd_shell)

    for name, func in (("list", cmd_list), ("ls", cmd_list), ("status", cmd_status)):
        p = sub.add_parser(name)
        p.add_argument("-v", "--verbose", action="store_true")
        p.set_defaults(func=func)

    sub.add_parser("justin").set_defaults(func=cmd_justin)
    sub.add_parser("edit").set_defaults(func=cmd_edit)
    sub.add_parser("menu").set_defaults(func=cmd_menu)

    p = sub.add_parser("add")
    p.add_argument("name")
    p.add_argument("area")
    p.add_argument("--desc", default="")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("rm")
    p.add_argument("name")
    p.set_defaults(func=cmd_rm)

    p = sub.add_parser("set")
    p.add_argument("key")
    p.add_argument("value")
    p.add_argument("--env", default="")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("pkg")
    p.add_argument("action", choices=("add", "rm", "list"), nargs="?", default="list")
    p.add_argument("spec", nargs="*")
    p.add_argument("--env", default="")
    p.set_defaults(func=cmd_pkg)

    p = sub.add_parser("new")
    p.add_argument("name", help="environment name to register, e.g. pana26")
    p.add_argument("area", help="the folder you created for the MRB area ('.' works)")
    p.add_argument("-v", "--version", required=True, help="dunesw release, e.g. v10_26_00d05")
    p.add_argument("-q", "--qualifier", "--qual", help="default: [defaults] qualifier")
    p.add_argument("--project", help="MRB_PROJECT name; default: [newdev] project")
    p.add_argument("-p", "--pkg", action="append", default=[], help="package to mrb g (repeatable; replaces the list)")
    p.add_argument("-j", "--jobs", type=int, help="parallel build jobs; default: [newdev] jobs")
    p.add_argument("--no-build", action="store_true", help="stop after mrb g")
    p.add_argument("--build-only", action="store_true", help="only build an area made before")
    p.add_argument("-n", "--dry-run", action="store_true")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("rebuild")
    p.add_argument("name", help="registered environment, e.g. nbana")
    p.add_argument("--clean", action="store_true", help="from scratch: mrb z, mrbsetenv, mrb i")
    p.add_argument("-j", "--jobs", type=int, help="parallel build jobs; default: [newdev] jobs")
    p.add_argument("-v", "--version", help="only if the area holds several builds")
    p.add_argument("-q", "--qualifier", "--qual", help="only if the area holds several builds")
    p.add_argument("-n", "--dry-run", action="store_true")
    p.set_defaults(func=cmd_rebuild)

    p = sub.add_parser("scan")
    p.add_argument("dir", nargs="?", default="/exp/dune/app/users/${USER}")
    p.add_argument("--depth", type=int, default=3)
    p.set_defaults(func=cmd_scan)
    return parser


def main(argv):
    cfg = Config(CONFIG_PATH)

    if not argv:
        return cmd_menu(cfg, None) if sys.stdin.isatty() else (print(HELP.format(b=BOLD, r=RESET)) or 0)
    if argv[0] in ("-h", "--help", "help"):
        print(HELP.format(b=BOLD, r=RESET))
        return 0
    # Shortcuts: "dunenv pana", "dunenv build", "dunenv pana build" -> start (setup inside a container).
    if argv[0] not in COMMANDS and not argv[0].startswith("-"):
        if argv[0] in cfg.env_names() or argv[0] in ("build", "normal") or argv[0].lower() in NO_ENV_NAMES:
            argv = ["setup" if in_container() else "start"] + argv
        else:
            return fail("unknown command or environment '{}'  (dunenv help, dunenv list)".format(argv[0]))

    args = build_parser().parse_args(argv)
    if not hasattr(args, "func"):
        print(HELP.format(b=BOLD, r=RESET))
        return 2
    return args.func(cfg, args) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
