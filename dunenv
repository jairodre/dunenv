NO_ENV_NAMES = ("none", "base", "dunesw", "")


# ===========================================================================
# Block 3 - Reading the configuration
# ===========================================================================

def _expand(value):
    return os.path.expandvars(os.path.expanduser(value))


def _lines(value):
    """Multi-line config value -> list of non-empty lines."""
    return [line.strip() for line in (value or "").splitlines() if line.strip()]


class Config:
    def __init__(self, path):
        self.path = path
        if not os.path.exists(path):
            with open(path, "w") as handle:
                handle.write(DEFAULT_CONFIG)
            eprint("{}created{} {}".format(GREEN, RESET, path))
        self.parser = configparser.ConfigParser(interpolation=None)
        self.parser.optionxform = str        # keep the case of exported variable names
        self.parser.read(path)

    def get(self, section, key, default=""):
        return _expand(self.parser.get(section, key, fallback=default).strip())

    def flag(self, section, key, default=True):
        return self.parser.getboolean(section, key, fallback=default)

    def env_names(self):
        return [s[4:] for s in self.parser.sections() if s.startswith("env:")]

    def env(self, name):
        section = "env:" + name
        if not self.parser.has_section(section):
            return None
        return {key: self.parser.get(section, key) for key in self.parser.options(section)}


# ===========================================================================
# Block 4 - Local MRB areas
#   An MRB area contains localProducts_<project>_<version>_<qual>/setup.
#   The folder name tells which dunesw release the area was built against.
# ===========================================================================

LOCAL_PRODUCTS_RE = re.compile(
    r"^localProducts_(?P<project>.+?)_(?P<version>v\d+_\d+_\d+[A-Za-z0-9]*)_(?P<qual>[A-Za-z0-9_]+)$")


def find_local_products(area):
    """All usable localProducts_* folders in an MRB area."""
    found = []
    if not os.path.isdir(area):
        return found
    for name in sorted(os.listdir(area)):
        match = LOCAL_PRODUCTS_RE.match(name)
        setup_file = os.path.join(area, name, "setup")
        if match and os.path.isfile(setup_file):
            found.append({
                "dir": os.path.join(area, name),
                "setup": setup_file,
                "project": match.group("project"),
                "version": match.group("version"),
                "qualifier": match.group("qual").replace("_", ":"),
            })
    return found


def describe_products(products):
    return ", ".join("{} -q {}".format(p["version"], p["qualifier"]) for p in products) or "none"


# ===========================================================================
# Block 5 - Plan: what one setup run will do
#   Resolution order for the dunesw release:
#     local env  -> the release of its localProducts_* folder
#                   (-v/-q, or the env's version/qualifier keys, only choose
#                    among several folders; a mismatch is an error, because
#                    the local build only works with its own release)
#     no env     -> -v/-q from the command line, else [defaults]
# ===========================================================================

class PlanError(Exception):
    pass


def make_plan(cfg, env_name=None, version=None, qualifier=None, extra_packages=(),
              grid=None, dev=False, flavor="normal"):
    if env_name is None:
        env_name = cfg.get("defaults", "env", "none")
    env_name = env_name.strip()
    default_version = cfg.get("defaults", "version")
    default_qualifier = cfg.get("defaults", "qualifier")

    plan = {
        "env": "none",
        "local": None,
        "after": [],
        "flavor": flavor,
        "dev": dev,
        "grid": cfg.flag("defaults", "grid", True) if grid is None else grid,
    }
    env_packages = []

    if env_name.lower() in NO_ENV_NAMES:
        plan["version"] = version or default_version
        plan["qualifier"] = qualifier or default_qualifier
    else:
        env = cfg.env(env_name)
        if env is None:
            raise PlanError("unknown environment '{}'. Known: {}  (add one with: dunenv add {} <area>)"
                            .format(env_name, ", ".join(cfg.env_names()) or "none", env_name))
        area = _expand(env.get("area", ""))
        products = find_local_products(area)
        if not products:
            raise PlanError("environment '{}': no localProducts_*/setup in {}".format(env_name, area))

        want_version = version or _expand(env.get("version", "")).strip()
        want_qualifier = qualifier or _expand(env.get("qualifier", "")).strip()
        matches = [p for p in products
                   if (not want_version or p["version"] == want_version)
                   and (not want_qualifier or p["qualifier"] == want_qualifier)]
        if not matches:
            raise PlanError(
                "environment '{}' has no build for {} -q {}.\n"
                "       Available in {}: {}\n"
                "       Drop -v/-q to use the built release, or create a new MRB area for {} and\n"
                "       register it:  dunenv add <name> <new area>"
                .format(env_name, want_version or "*", want_qualifier or "*", area,
                        describe_products(products), want_version or "that release"))
        if len(matches) > 1:
            preferred = [p for p in matches
                         if p["version"] == default_version and p["qualifier"] == default_qualifier]
            if len(preferred) != 1:
                raise PlanError("environment '{}' has several builds ({}); choose one with -v/-q "
                                "or set version/qualifier in [env:{}]"
                                .format(env_name, describe_products(matches), env_name))
            matches = preferred

        plan.update(env=env_name, local=matches[0], area=area,
                    version=matches[0]["version"], qualifier=matches[0]["qualifier"])
        plan["after"] = _lines(env.get("after", ""))
        env_packages = _lines(env.get("packages", ""))

    # UPS packages: [defaults] list, then the env list, then -p options.
    lines = _lines(cfg.parser.get("defaults", "packages", fallback="")) + env_packages + list(extra_packages)
    plan["packages"] = [line.format(version=plan["version"], qualifier=plan["qualifier"]) for line in lines]
    return plan


def equivalent_command(plan, default_env):
    """The short command that reproduces a plan (shown after the menu)."""
    words = ["dunenv", "start"]
    if plan["env"] != "none" or default_env.lower() not in NO_ENV_NAMES:
        words.append(plan["env"])
    if plan["flavor"] == "build":
        words.append("build")
    if not plan["grid"]:
        words.append("--no-grid")
    return " ".join(words)


# ===========================================================================
# Block 6 - Bash generation
#   Every block of the generated script prints a header so the terminal
#   shows which step is running. Steps:
#     1 exports   2 UPS + dunesw   3 extra packages   4 local MRB env
#     5 profile   6 token + JUSTIN + Rucio   7 cd workdir
# ===========================================================================

def _q(value):
    return shlex.quote(value)


def bash_grid_function(cfg):
    """JUSTIN check -> token -> Rucio account. Stops cleanly when JUSTIN needs the browser."""
    return """\
_dunenv_grid() {{
    local out st
    printf '\\n=== {b}JUSTIN / Rucio{r} ===\\n'
    out="$(justin time 2>&1)"; st=$?
    printf '%s\\n' "$out"
    if ((st != 0)) || [[ "$out" == *"authorize this computer"* ]]; then
        printf '\\n{y}JUSTIN authorization is required.{r}\\n'
        printf 'Finish the browser authorization, then run:  dunenv justin\\n'
        return 20
    fi
    justin get-token || return $?
    export RUCIO_ACCOUNT={account}
    rucio whoami || return $?
}}
""".format(b=BOLD, r=RESET, y=YELLOW, account=_q(cfg.get("grid", "rucio_account", "justinreadonly")))


def bash_export_lines(cfg):
    """The [exports] section as 'export NAME=value' lines (indented for a function body)."""
    names = cfg.parser.options("exports") if cfg.parser.has_section("exports") else []
    return ["    export {}={}".format(name, _q(cfg.get("exports", name))) for name in names]


def bash_setup_script(cfg, plan):
    out = []
    add = out.append
    add("# --- generated by dunenv: env={} dunesw {} -q {} ---".format(
        plan["env"], plan["version"], plan["qualifier"]))
    add("_dunenv_ups() {")
    add("    printf '  setup %s\\n' \"$*\"")
    add("    setup \"$@\" || printf '  {}WARNING{} setup %s failed\\n' \"$*\" >&2".format(RED, RESET))
    add("}")
    add(bash_grid_function(cfg))
    add("_dunenv_setup() {")

    add("    # 1) Variables needed before the UPS bootstrap")
    out.extend(bash_export_lines(cfg))

    add("    # 2) UPS bootstrap + dunesw")
    add("    source {} || return 1".format(_q(cfg.get("defaults", "ups_setup"))))
    add("    export DUNESW_VERSION={} DUNESW_QUALIFIER={}".format(_q(plan["version"]), _q(plan["qualifier"])))
    add("    printf '\\n=== Setting up {g}dunesw %s{r} with qualifier {y}%s{r} ===\\n\\n' "
        "\"$DUNESW_VERSION\" \"$DUNESW_QUALIFIER\"".format(g=GREEN, y=YELLOW, r=RESET))
    add("    setup dunesw \"$DUNESW_VERSION\" -q \"$DUNESW_QUALIFIER\" || "
        "{{ printf '{}setup dunesw failed{}\\n' >&2; return 1; }}".format(RED, RESET))

    if plan["packages"]:
        add("    # 3) Extra UPS products")
        add("    printf '\\n=== UPS products ===\\n'")
        for line in plan["packages"]:
            add("    _dunenv_ups {}".format(line))

    local = plan["local"]
    if local:
        add("    # 4) Local MRB environment '{}'".format(plan["env"]))
        add("    printf '\\n=== Local environment {b}{name}{r} ===\\n'".format(b=BOLD, r=RESET, name=plan["env"]))
        add("    source {} || return 2".format(_q(local["setup"])))
        if plan["dev"]:
            add("    mrbsetenv || return 2")
        add("    mrbslp")
        for line in plan["after"]:
            add("    " + line)
        add("    printf 'Local %s sourced from: %s\\nVersion: %s  Qualifiers: %s\\n' "
            "\"$MRB_PROJECT\" \"$MRB_TOP\" \"$MRB_PROJECT_VERSION\" \"$MRB_QUALS\"")
    add("    export DUNENV_ACTIVE={}".format(_q(plan["env"])))

    profile = cfg.get("defaults", "profile")
    if profile:
        add("    # 5) Personal profile")
        add("    [[ -r {p} ]] && source {p}".format(p=_q(profile)))

    if plan["grid"]:
        add("    # 6) Token + JUSTIN + Rucio")
        add("    printf '\\n=== Token ===\\n'")
        add("    {}".format(cfg.get("grid", "token_cmd")))
        add("    _dunenv_grid")
        add("    local grid_status=$?")
    add("    printf '\\n{g}dunenv ready:{r} env=%s  dunesw %s -q %s\\n' "
        "\"$DUNENV_ACTIVE\" \"$DUNESW_VERSION\" \"$DUNESW_QUALIFIER\"".format(g=GREEN, r=RESET))
    workdir = cfg.get("defaults", "workdir")
    if workdir:
        add("    # 7) Working folder (last, so the folder listing ends the output)")
        add("    cd {} && echo \"$PWD\"".format(_q(workdir)))
    if plan["grid"]:
        add("    return $grid_status")
    add("}")
    add("_dunenv_setup")
    return "\n".join(out) + "\n"


def bash_justin_script(cfg):
    return bash_grid_function(cfg) + "_dunenv_grid\n"


# ===========================================================================
# Block 7 - Handing a script to the current shell, or to a new container
# ===========================================================================

def deliver_to_shell(script, args_for_hint):
    """Write the script where the 'dunenv' bash function will source it."""
    target = os.environ.get("DUNENV_EMIT")
    if target:
        with open(target, "w") as handle:
            handle.write(script)
        return 0
    eprint("{}This step changes the current shell, so it must be sourced.{}".format(YELLOW, RESET))
    eprint("  Load the shell function once:  source {}".format(HOOK_PATH))
    eprint("  then run:                       dunenv {}".format(args_for_hint))
    eprint("  or, without the function:       source <({} script ...)".format(os.path.realpath(__file__)))
    return 2


def launch_container(cfg, flavor, script=None, dry_run=False):
    apptainer = cfg.get("container", "apptainer")
    image = cfg.get("container", "image")
    binds = cfg.get("container", "build_binds" if flavor == "build" else "binds")
    argv = [apptainer, "exec", "-B", binds, "--ipc", "--pid", image,
            "/bin/bash", "--rcfile", HOOK_PATH, "-i"]
    env = dict(os.environ)
    if script:
        env["APPTAINERENV_DUNENV_AUTORUN"] = base64.b64encode(script.encode()).decode()

    label = GREEN + "BUILD" + RESET + " container" if flavor == "build" else BOLD + "container" + RESET
    print("\n=== Entering FNAL SL7 {} ===\n".format(label))
    if dry_run:
        print("{}[dry run]{} {}".format(YELLOW, RESET, " ".join(_q(a) for a in argv)))
        if script:
            print("\n# script run inside the container (DUNENV_AUTORUN):\n" + script)
        return 0
    sys.stdout.flush()
    os.execve(apptainer, argv, env)


# ===========================================================================
# Block 8 - Small text editor for dunenv.ini
#   configparser would drop every comment when writing, so edits are done on
#   the text lines instead, then re-parsed to make sure the file is still valid.
# ===========================================================================

class IniText:
    HEADER = re.compile(r"^\s*\[(?P<name>[^\]]+)\]\s*$")

    def __init__(self, path):
        self.path = path
        with open(path) as handle:
            self.lines = handle.read().splitlines()

    def section(self, name):
        """(header index, end index) of a section, end = next header or EOF."""
        start = None
        for i, line in enumerate(self.lines):
            match = self.HEADER.match(line)
            if match and start is not None:
                return start, i
            if match and match.group("name").strip() == name:
                start = i
        if start is None:
            return None
        return start, len(self.lines)

    def key(self, section, key):
        """(key line, end of its indented continuation) or None."""
        rng = self.section(section)
        if rng is None:
            return None
        pattern = re.compile(r"^{}\s*[=:]".format(re.escape(key)))
        for i in range(rng[0] + 1, rng[1]):
            if pattern.match(self.lines[i]):
                end = i + 1
                while end < rng[1] and self.lines[end][:1] in (" ", "\t") and self.lines[end].strip():
                    end += 1
                return i, end
        return None

    def _section_body_end(self, section):
        start, end = self.section(section)
        while end > start + 1 and not self.lines[end - 1].strip():
            end -= 1
        return end

    def set(self, section, key, value):
        if self.section(section) is None:
            self.lines += ["", "[{}]".format(section)]
        found = self.key(section, key)
        new_line = "{} = {}".format(key, value)
        if found:
            self.lines[found[0]:found[1]] = [new_line]
        else:
            self.lines.insert(self._section_body_end(section), new_line)

    def add_item(self, section, key, item):
        found = self.key(section, key)
        if found:
            self.lines.insert(found[1], "    " + item)
        else:
            self.lines[self._section_body_end(section):self._section_body_end(section)] = \
                ["{} =".format(key), "    " + item]

    def remove_item(self, section, key, product):
        found = self.key(section, key)
        if not found:
            return False
        for i in range(found[0] + 1, found[1]):
            words = self.lines[i].split()
            if words and words[0] == product:
                del self.lines[i]
                return True
        return False

    def append_section(self, name, body):
        while self.lines and not self.lines[-1].strip():
            self.lines.pop()
        self.lines += ["", "[{}]".format(name)] + body

    def remove_section(self, name):
        rng = self.section(name)
        if rng is None:
            return False
        start, end = rng
        while start > 0 and not self.lines[start - 1].strip():
            start -= 1
        del self.lines[start:end]
        return True

    def save(self):
        text = "\n".join(self.lines) + "\n"
        check = configparser.ConfigParser(interpolation=None)
        check.read_string(text)                       # raises if the edit broke the file
        tmp = self.path + ".tmp"
        with open(tmp, "w") as handle:
            handle.write(text)
        os.replace(tmp, self.path)


# ===========================================================================
# Block 9 - Commands
# ===========================================================================

def _plan_from_args(cfg, args):
    """Read the free words of start/setup: env name, 'build', 'normal', 'none'."""
    env_name, flavor = None, "build" if getattr(args, "build", False) else "normal"
    for word in args.words:
        if word == "build":
            flavor = "build"
        elif word == "normal":
            flavor = "normal"
        elif env_name is None:
            env_name = word
        else:
            raise PlanError("more than one environment given: {} and {}".format(env_name, word))
    return make_plan(cfg, env_name=env_name, version=args.version, qualifier=args.qualifier,
                     extra_packages=args.pkg, grid=args.grid, dev=args.dev, flavor=flavor)


def print_plan(plan):
    print("  container : {}".format(plan["flavor"]))
    print("  dunesw    : {} -q {}".format(plan["version"], plan["qualifier"]))
    if plan["local"]:
        print("  local env : {}  ({}{})".format(plan["env"], plan["local"]["dir"],
                                                 ", mrbsetenv" if plan["dev"] else ""))
    else:
        print("  local env : none")
    print("  packages  : {}".format(", ".join(plan["packages"]) or "none"))
    print("  grid      : {}".format("token + JUSTIN + Rucio" if plan["grid"] else "off"))


def cmd_start(cfg, args):
    if in_container():
        eprint("{}Already inside a container{}: running the setup in this shell instead.".format(YELLOW, RESET))
        return cmd_setup(cfg, args)
    try:
        plan = _plan_from_args(cfg, args)
    except PlanError as err:
        return fail(err)
    print_plan(plan)
    return launch_container(cfg, plan["flavor"], bash_setup_script(cfg, plan), args.dry_run)


def cmd_setup(cfg, args):
    try:
        plan = _plan_from_args(cfg, args)
    except PlanError as err:
        return fail(err)
    if not in_container() and not args.dry_run:
        return fail("setup runs inside the SL7 container. On the host use:  dunenv start {}"
                    .format(" ".join(args.words)))
    print_plan(plan)
    script = bash_setup_script(cfg, plan)
    if args.dry_run:
        print(script)
        return 0
    return deliver_to_shell(script, "setup " + " ".join(args.words))


def cmd_script(cfg, args):
    try:
        print(bash_setup_script(cfg, _plan_from_args(cfg, args)), end="")
    except PlanError as err:
        return fail(err)
    return 0


def cmd_justin(cfg, args):
    return deliver_to_shell(bash_justin_script(cfg), "justin")


def cmd_shell(cfg, args):
    if in_container():
        return fail("already inside a container")
    flavor = "build" if (args.build or "build" in args.words) else "normal"
    return launch_container(cfg, flavor, None, args.dry_run)


def cmd_list(cfg, args):
    print("{}config{}  {}".format(BOLD, RESET, cfg.path))
    print("{}default{} dunesw {} -q {}   env={}   grid={}".format(
        BOLD, RESET, cfg.get("defaults", "version"), cfg.get("defaults", "qualifier"),
        cfg.get("defaults", "env", "none"), cfg.get("defaults", "grid", "yes")))
    print("{}packages{} {}".format(BOLD, RESET,
                                   ", ".join(_lines(cfg.parser.get("defaults", "packages", fallback=""))) or "none"))
    print("\n{}environments{}".format(BOLD, RESET))
    print("  {:<12} {:<28} {}".format("none", "(default release)", "dunesw + packages only"))
    for name in cfg.env_names():
        env = cfg.env(name)
        products = find_local_products(_expand(env.get("area", "")))
        status = describe_products(products) if products else RED + "no localProducts found" + RESET
