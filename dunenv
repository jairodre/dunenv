        print("\n{}active UPS products{}".format(BOLD, RESET))
        sys.stdout.flush()
        subprocess.call([os.path.join(os.environ["UPS_DIR"], "bin", "ups"), "active"])
    return 0


def env_name_problem(cfg, name):
    """Why NAME cannot be a new environment name, or '' if it can."""
    if name.lower() in NO_ENV_NAMES or name in ("build", "normal") or name in COMMANDS:
        return "'{}' is a reserved word".format(name)
    if not re.match(r"^[A-Za-z0-9_.-]+$", name):
        return "environment names may only use letters, digits, '_', '.', '-'"
    if cfg.env(name) is not None:
        return "environment '{}' already exists (remove it first: dunenv rm {})".format(name, name)
    return ""


def register_env(cfg, name, area, desc=""):
    """Append an [env:NAME] block for an existing MRB area."""
    products = find_local_products(area)
    if not products:
        return fail("no localProducts_*/setup found in {}".format(area))
    body = ["desc = {}".format(desc or "Local {} ({})".format(products[0]["project"], os.path.basename(area))),
            "area = {}".format(area)]
    text = IniText(cfg.path)
    text.append_section("env:" + name, body)
    text.save()
    print("{}added{} env '{}' -> {}  [{}]".format(GREEN, RESET, name, area, describe_products(products)))
    print("start it with:  dunenv start {}".format(name))
    return 0


def cmd_add(cfg, args):
    problem = env_name_problem(cfg, args.name)
    if problem:
        return fail(problem)
    return register_env(cfg, args.name, os.path.abspath(_expand(args.area)), args.desc)


def cmd_rm(cfg, args):
    text = IniText(cfg.path)
    if not text.remove_section("env:" + args.name):
        return fail("no environment '{}'".format(args.name))
    text.save()
    print("removed env '{}' (the MRB area itself is untouched)".format(args.name))
    return 0


SETTABLE = ("version", "qualifier", "env", "grid", "workdir", "profile", "ups_setup")


def cmd_set(cfg, args):
    section = "env:" + args.env if args.env else "defaults"
    if args.env and cfg.env(args.env) is None:
        return fail("no environment '{}'".format(args.env))
    if not args.env and args.key not in SETTABLE:
        return fail("settable defaults: {}".format(", ".join(SETTABLE)))
    if args.key == "env" and args.value.lower() not in NO_ENV_NAMES and cfg.env(args.value) is None:
        return fail("no environment '{}'".format(args.value))
    text = IniText(cfg.path)
    text.set(section, args.key, args.value)
    text.save()
    print("[{}] {} = {}".format(section, args.key, args.value))
    return 0


def cmd_pkg(cfg, args):
    section = "env:" + args.env if args.env else "defaults"
    if args.env and cfg.env(args.env) is None:
        return fail("no environment '{}'".format(args.env))
    if args.action == "list":
        print("[{}] packages:".format(section))
        for line in _lines(cfg.parser.get(section, "packages", fallback="")):
            print("    " + line)
        return 0
    if not args.spec:
        return fail("give the package, e.g.  dunenv pkg {} \"duneprototypes {{version}} -q {{qualifier}}\""
                    .format(args.action))
    spec = " ".join(args.spec)
    text = IniText(cfg.path)
    if args.action == "add":
        text.add_item(section, "packages", spec)
    elif not text.remove_item(section, "packages", spec.split()[0]):
        return fail("'{}' is not in [{}] packages".format(spec.split()[0], section))
    text.save()
    print("[{}] packages {} {}".format(section, "+" if args.action == "add" else "-", spec))
    return 0


def cmd_scan(cfg, args):
    """Look for MRB areas (folders holding localProducts_*) a few levels down."""
    root = os.path.abspath(_expand(args.dir))
    known = {_expand(cfg.env(n).get("area", "")).rstrip("/"): n for n in cfg.env_names()}
    skip = {"srcs", "build_slf7.x86_64", "build_sl7.x86_64", ".git"}
    base_depth = root.rstrip("/").count("/")
    for top, dirs, _files in os.walk(root):
        if top.count("/") - base_depth >= args.depth:
            dirs[:] = []
        products = [d for d in dirs if d.startswith("localProducts_")]
        if products:
            found = find_local_products(top)
            tag = "registered as '{}'".format(known[top]) if top in known else YELLOW + "not registered" + RESET
            print("{}  [{}]  {}".format(top, describe_products(found), tag))
        dirs[:] = [d for d in dirs if d not in skip and not d.startswith((".", "localProducts_", "build_"))]
    return 0


def cmd_edit(cfg, args):
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vim"
    return subprocess.call(shlex.split(editor) + [cfg.path])


# ===========================================================================
# Block 9b - "dunenv new": fill and build a new MRB area
#   You create the folder; this runs your usual steps in it:
#       export MRB_PROJECT=<project>; mrb newDev -v <ver> -q <qual>
#       source localProducts_<project>_<ver>_<qual>/setup
#       cd srcs; mrb g -t <ver> <pkg> ...        ([newdev] packages, in order)
#       cd $MRB_BUILDDIR; mrb z; mrbsetenv; mrb i -j <jobs>
#   and registers the area as [env:<name>].
#
#   Checks, before anything is created:
#     host   : folder exists and is empty, or a half-finished area of this
#              same project/release; build step -> machine matches build_hosts
#     inside : release exists in UPS; tag exists on GitHub for every package;
#              build_hosts checked again right before "mrb z / mrb i"
#   Steps already done are skipped, so after a failure the same command
#   continues where it stopped. Output is also saved in <area>/dunenv_new_*.log.
#
#   Modes:  (default) everything | --no-build: stop after mrb g (add your
#           modules) | --build-only: just the build of an existing area
# ===========================================================================

SAFE_WORD = re.compile(r"^[A-Za-z0-9_.:+-]+$")       # versions, qualifiers, projects, packages
SAFE_HOST_PATTERN = re.compile(r"^[A-Za-z0-9_.*?-]+$")


def host_names():
    """Short and full name of this machine (both are matched against build_hosts)."""
    names = {os.uname()[1]}
    try:
        names.add(socket.getfqdn())
    except OSError:
        pass
    return sorted(name for name in names if name)


def on_build_host(patterns):
    return any(fnmatch.fnmatch(name, pattern) for name in host_names() for pattern in patterns)


def area_problem(area, lp_name):
    """Why AREA cannot be used, or '' when it is empty or a half-finished area of this release."""
    if not os.path.isdir(area):
        return "folder {} does not exist. Create it first (dunenv new never creates it).".format(area)
    unexpected = []
    for entry in sorted(os.listdir(area)):
        if entry.startswith("."):
            continue
        if entry in ("srcs", lp_name) or entry.startswith("build_") or fnmatch.fnmatch(entry, "dunenv_*.log"):
            continue
        unexpected.append(entry)
    if unexpected:
        shown = ", ".join(unexpected[:8]) + (" ..." if len(unexpected) > 8 else "")
        return ("{} is neither empty nor a half-finished {} area.\n       Unexpected: {}"
                .format(area, lp_name, shown))
    return ""


NEWDEV_HEAD = r"""# --- generated by @COMMAND@: @NAME@ in @AREA@ ---
AREA=@AREA_Q@
PROJECT=@PROJECT_Q@
VERSION=@VERSION_Q@
QUALIFIER=@QUALIFIER_Q@
JOBS=@JOBS@
LOCAL_PRODUCTS="$AREA/@LP_NAME@"
LOG="$AREA/@LOG_PREFIX@_@STAMP@.log"
# mrbsetenv / mrbslp are UPS "aliases": eval + expand_aliases runs them either way
shopt -s expand_aliases

_step() { printf '\n\033[1m=== [%s] %s ===\033[0m\n' "$1" "$2"; }
_stop() { printf '\n\033[31mSTOP:\033[0m %s\n' "$*" >&2; exit 1; }

_on_build_host() {
    local h
    for h in "$(hostname -f 2>/dev/null)" "$(hostname)"; do
        case "$h" in
            @HOST_CASE@) return 0 ;;
        esac
    done
    return 1
}

_check_tag() {   # <package> <repository url>
    local refs
    refs="$(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/true git ls-remote --tags "$2" "refs/tags/$VERSION" 2>/dev/null </dev/null)"
    if [[ $? -ne 0 ]]; then
        printf '  \033[33mWARNING\033[0m could not read %s; mrb g will report a missing tag\n' "$2"
    elif [[ -z "$refs" ]]; then
        _stop "$1 has no tag $VERSION in $2"
    else
        printf '  %-16s tag %s found\n' "$1" "$VERSION"
    fi
}

_checkout() {    # <package>
    if [[ -d "$MRB_SOURCE/$1" ]]; then
        printf '  %-16s already in srcs/, skipping\n' "$1"
    else
        mrb g -t "$VERSION" "$1" || _stop "mrb g -t $VERSION $1 failed"
    fi
}

_dunenv_new() {
"""

NEWDEV_UPS = r"""
    _step 1 "UPS + dunesw $VERSION -q $QUALIFIER"
    source @UPS_SETUP_Q@ || _stop "UPS bootstrap failed"
    if ! ups exist dunesw "$VERSION" -q "$QUALIFIER"; then
        printf 'dunesw releases starting with %s:\n' "${VERSION:0:6}"
        ups list -aK+ dunesw | awk '{print $2}' | tr -d '"' | sort -u | grep "^${VERSION:0:6}" | tail -10
        _stop "dunesw $VERSION -q $QUALIFIER is not in UPS"
    fi
    setup dunesw "$VERSION" -q "$QUALIFIER" || _stop "setup dunesw failed"
"""

NEWDEV_TAGS = r"""
    _step 2 "Tags $VERSION on GitHub"
@TAG_LINES@
"""

NEWDEV_CREATE = r"""
    _step 3 "MRB area: $AREA"
    cd "$AREA" || _stop "cannot enter $AREA"
    if [[ -d "$LOCAL_PRODUCTS" ]]; then
        printf '  %s already there, skipping mrb newDev\n' "${LOCAL_PRODUCTS##*/}"
    else
        export MRB_PROJECT="$PROJECT"
        # This run's own log is already in the folder, and mrb newDev refuses any
        # non-empty folder. Use -f only when the only entries (hidden ones
        # included) are dunenv_*.log files and .locks, which mrb newDev
        # creates itself before that check; otherwise let mrb's check decide.
        local others
        others="$(ls -A "$AREA" | grep -v -e '^dunenv_.*\.log$' -e '^\.locks$')"
        if [[ -z "$others" ]]; then
            mrb newDev -f -v "$VERSION" -q "$QUALIFIER" || _stop "mrb newDev failed"
        else
            mrb newDev -v "$VERSION" -q "$QUALIFIER" || _stop "mrb newDev failed"
        fi
        [[ -d "$LOCAL_PRODUCTS" ]] || _stop "mrb newDev did not create ${LOCAL_PRODUCTS##*/} (found: $(ls "$AREA" | tr '\n' ' '))"
    fi
"""

NEWDEV_SOURCE = r"""
    [[ -r "$LOCAL_PRODUCTS/setup" ]] || _stop "no $LOCAL_PRODUCTS/setup: the area was never created (dunenv new without --build-only)"
    source "$LOCAL_PRODUCTS/setup" || _stop "source ${LOCAL_PRODUCTS##*/}/setup failed"
"""

NEWDEV_CHECKOUT = r"""
    _step 4 "Check out packages at $VERSION"
    cd "$MRB_SOURCE" || _stop "MRB_SOURCE is not set"
@CHECKOUT_LINES@
"""

NEWDEV_HOST_CHECK = r"""
    _step @STEP_HOST@ "Build machine check"
    _on_build_host || _stop "this is $(hostname -f 2>/dev/null || hostname): builds with -j $JOBS only run on @HOST_LIST@"
    printf '  %s matches @HOST_LIST@\n' "$(hostname -f 2>/dev/null || hostname)"
"""

# Clean build: everything recompiled from scratch (dunenv new, --build-only, rebuild --clean)
NEWDEV_BUILD = NEWDEV_HOST_CHECK + r"""
    _step @STEP_BUILD@ "Clean build: mrb z, mrbsetenv, mrb i -j $JOBS"
    cd "$MRB_BUILDDIR" || _stop "MRB_BUILDDIR is not set"
    mrb z
    eval mrbsetenv || _stop "mrbsetenv failed"
    mrb i -j "$JOBS" || _stop "build failed (mrb i): full output in $LOG"
    eval mrbslp
    printf '\n\033[1;32m@COMMAND@: built.\033[0m Log: %s\n' "$LOG"
"""

# Incremental build (dunenv rebuild): for edits inside existing module folders.
# New folders added with add_subdirectory need the clean build (--clean).
REBUILD_INCREMENTAL = NEWDEV_HOST_CHECK + r"""
    _step @STEP_BUILD@ "Incremental build: mrbsetenv, make install -j $JOBS"
    cd "$MRB_BUILDDIR" || _stop "MRB_BUILDDIR is not set"
    [[ -f Makefile ]] || _stop "$MRB_BUILDDIR has no Makefile (never built, or emptied by mrb z): use --clean"
    eval mrbsetenv || _stop "mrbsetenv failed"
    make install -j "$JOBS" || _stop "build failed (make install): full output in $LOG"
    eval mrbslp
    printf '\n\033[1;32m@COMMAND@: built.\033[0m Log: %s\n' "$LOG"
"""

NEWDEV_NO_BUILD_END = r"""
    printf '\n\033[1;32mdunenv new: area ready, not built.\033[0m Log: %s\n' "$LOG"
    printf 'Add your modules to %s, then build on a build machine with:\n  %s\n' "$MRB_SOURCE" @BUILD_ONLY_CMD_Q@
"""

NEWDEV_TAIL = r"""}

_dunenv_new 2>&1 | tee -a "$LOG"
exit "${PIPESTATUS[0]}"
"""


def bash_newdev_script(cfg, spec):
    """Assemble the bash run inside the build container for 'dunenv new' / 'dunenv rebuild'.

    spec["mode"]:  full | no-build | build-only      (dunenv new)
                   rebuild | rebuild-clean           (dunenv rebuild)
    """
    rebuild = spec["mode"].startswith("rebuild")
    step_host, step_build = ("2", "3") if rebuild else ("5", "6")
    tokens = {
        "@COMMAND@": "dunenv rebuild" if rebuild else "dunenv new",
        "@LOG_PREFIX@": "dunenv_rebuild" if rebuild else "dunenv_new",
        "@STEP_HOST@": step_host,
        "@STEP_BUILD@": step_build,
        "@NAME@": spec["name"],
        "@AREA@": spec["area"],
        "@AREA_Q@": _q(spec["area"]),
        "@PROJECT_Q@": _q(spec["project"]),
        "@VERSION_Q@": _q(spec["version"]),
        "@QUALIFIER_Q@": _q(spec["qualifier"]),
        "@JOBS@": str(spec["jobs"]),
        "@LP_NAME@": spec["lp_name"],
        "@STAMP@": time.strftime("%Y%m%d_%H%M%S"),
        "@HOST_CASE@": "|".join(spec["host_patterns"]),
        "@HOST_LIST@": " ".join(spec["host_patterns"]),
        "@UPS_SETUP_Q@": _q(cfg.get("defaults", "ups_setup")),
        "@TAG_LINES@": "\n".join("    _check_tag {} {}".format(p, _q(spec["repo_url"].replace("{package}", p)))
                                 for p in spec["packages"]),
        "@CHECKOUT_LINES@": "\n".join("    _checkout {}".format(p) for p in spec["packages"]),
        "@BUILD_ONLY_CMD_Q@": _q(spec.get("build_only_cmd", "")),
    }

    chunks = [NEWDEV_HEAD, "\n".join(bash_export_lines(cfg)) + "\n", NEWDEV_UPS]
    if spec["mode"] == "rebuild":
        chunks += [NEWDEV_SOURCE, REBUILD_INCREMENTAL]
    elif spec["mode"] in ("build-only", "rebuild-clean"):
        chunks += [NEWDEV_SOURCE, NEWDEV_BUILD]
    else:
        chunks += [NEWDEV_TAGS, NEWDEV_CREATE, NEWDEV_SOURCE, NEWDEV_CHECKOUT]
        chunks.append(NEWDEV_NO_BUILD_END if spec["mode"] == "no-build" else NEWDEV_BUILD)
    chunks.append(NEWDEV_TAIL)

    script = "".join(chunks)
    for token, value in tokens.items():
        script = script.replace(token, value)
    return script


def build_settings(cfg, jobs_option):
    """(jobs, host_patterns) from -j and [newdev]. Raises PlanError when invalid."""
    try:
        jobs = jobs_option if jobs_option is not None else int(cfg.get("newdev", "jobs", "20") or 20)
    except ValueError:
        raise PlanError("[newdev] jobs must be a number")
    if jobs < 1:
        raise PlanError("-j must be at least 1")
    host_patterns = cfg.get("newdev", "build_hosts", "dunebuild*.fnal.gov").replace(",", " ").split()
    if not host_patterns or not all(SAFE_HOST_PATTERN.match(p) for p in host_patterns):
        raise PlanError("[newdev] build_hosts must be host patterns like dunebuild*.fnal.gov")
    return jobs, host_patterns


def build_host_refusal(host_patterns, jobs, advice):
    """Message for a build started outside the build machines, or '' on a build machine."""
    if on_build_host(host_patterns):
        return ""
    return ("this is {}: builds with -j {} only run on {}.\n"
            "       Log in to a build machine (e.g. ssh {}@dunebuild02.fnal.gov){}"
            .format(" / ".join(host_names()), jobs, " ".join(host_patterns),
                    os.environ.get("USER", "you"), advice))


def run_build_container(cfg, script, dry_run):
    """Run the script in a fresh build container and wait for it (or only print it with -n)."""
    argv = [cfg.get("container", "apptainer"), "exec", "-B", cfg.get("container", "build_binds"),
            "--ipc", "--pid", cfg.get("container", "image"),
            "/bin/bash", "--noprofile", "--norc", "-c", script]
    if dry_run:
        print("\n{}[dry run]{} {} ... /bin/bash --noprofile --norc -c <script below>\n".format(
            YELLOW, RESET, " ".join(_q(a) for a in argv[:8])))
        print(script)
        return 0
    print("\n=== Entering FNAL SL7 {}BUILD{} container (closes when done) ===".format(GREEN, RESET))
    sys.stdout.flush()
    return subprocess.call(argv)


def cmd_new(cfg, args):
    # --- 1. Options, with [newdev] defaults --------------------------------
    if in_container():
        return fail("run 'dunenv new' on the host: it opens its own build container")
    if args.no_build and args.build_only:
        return fail("--no-build and --build-only exclude each other")
    mode = "no-build" if args.no_build else "build-only" if args.build_only else "full"

    version = args.version
    qualifier = args.qualifier or cfg.get("defaults", "qualifier")
    packages = args.pkg or _lines(cfg.parser.get("newdev", "packages", fallback="protoduneana"))
    project = args.project or cfg.get("newdev", "project") or packages[0]
    repo_url = cfg.get("newdev", "repo_url", "https://github.com/DUNE/{package}.git")
    try:
        jobs, host_patterns = build_settings(cfg, args.jobs)
    except PlanError as err:
        return fail(err)

    if not LOCAL_PRODUCTS_RE.match("localProducts_x_{}_y".format(version)):
        return fail("version '{}' does not look like a release (vMM_mm_pp..., e.g. v10_26_00d05)".format(version))
    for label, word in [("qualifier", qualifier), ("project", project)] + [("package", p) for p in packages]:
        if not SAFE_WORD.match(word):
            return fail("{} '{}' has characters that are not allowed".format(label, word))

    # --- 2. Name and folder -------------------------------------------------
    area = os.path.abspath(_expand(args.area))
    lp_name = "localProducts_{}_{}_{}".format(project, version, qualifier.replace(":", "_"))
    existing = cfg.env(args.name)
    if existing is not None and _expand(existing.get("area", "")).rstrip("/") != area.rstrip("/"):
        return fail("environment '{}' already exists for another area ({}).".format(args.name, existing.get("area")))
    if existing is None:
        problem = env_name_problem(cfg, args.name)
        if problem:
            return fail(problem)
    problem = area_problem(area, lp_name)
    if problem:
        return fail(problem)
    if mode == "build-only" and not os.path.isfile(os.path.join(area, lp_name, "setup")):
        return fail("--build-only needs an existing {}/setup in {}".format(lp_name, area))

    # --- 3. Build machine (first check; the script checks again) ------------
    host_ok = on_build_host(host_patterns)
    if mode != "no-build" and not host_ok:
        message = build_host_refusal(host_patterns, jobs, ", or prepare the area\n"
                                     "       here with --no-build and build it later with --build-only.")
        if not args.dry_run:
            return fail(message)
        eprint("{}[dry run] the real run would stop here:{} {}".format(YELLOW, RESET, message))

    # --- 4. Plan, script, container ----------------------------------------
    build_only_cmd = "dunenv new {} {} --project {} -v {} -q {} --build-only".format(
        args.name, area, project, version, qualifier)
    spec = dict(name=args.name, area=area, project=project, version=version, qualifier=qualifier,
                packages=packages, jobs=jobs, host_patterns=host_patterns, repo_url=repo_url,
                lp_name=lp_name, mode=mode, build_only_cmd=build_only_cmd)

    print("  name      : {}{}".format(args.name, "  (already registered)" if existing else ""))
    print("  area      : {}{}".format(area, "  (empty)" if not os.listdir(area) else "  (continuing)"))
    print("  project   : {}  ->  {}".format(project, lp_name))
    print("  dunesw    : {} -q {}".format(version, qualifier))
    print("  packages  : {}   (mrb g -t {})".format(", ".join(packages), version))
    print("  build     : {}".format({"full": "mrb z, mrbsetenv, mrb i -j {}".format(jobs),
                                     "no-build": "no (stops after mrb g)",
                                     "build-only": "only: mrb z, mrbsetenv, mrb i -j {}".format(jobs)}[mode]))
    print("  host      : {}  ({})".format(" / ".join(host_names()),
                                          "build machine" if host_ok else "not a build machine"))

    status = run_build_container(cfg, bash_newdev_script(cfg, spec), args.dry_run)
    if args.dry_run:
        return 0
    if status != 0:
        return fail("dunenv new stopped (exit {}). Fix the reason above, then run the same command again:\n"
                    "       finished steps are skipped. Log: {}/dunenv_new_*.log".format(status, area), status)

    # --- 5. Register --------------------------------------------------------
    if existing is None:
        desc = "MRB {}: {} at {} -q {}".format(project, " + ".join(packages), version, qualifier)
        return register_env(Config(cfg.path), args.name, area, desc)
    print("environment '{}' already registered. Later rebuilds: dunenv rebuild {}".format(args.name, args.name))
    return 0


# ===========================================================================
# Block 9c - "dunenv rebuild": recompile a registered MRB area
#   Everything is read from the registered area: its folder from [env:<name>],
#   project / version / qualifier from its localProducts_<project>_<ver>_<qual>
#   folder. Nothing to remember, works from any folder.
#     dunenv rebuild NAME           incremental: mrbsetenv, make install -j N
#                                   for edits inside existing module folders
#                                   (.cc / .h, the module's own CMakeLists.txt,
#                                   e.g. libraries in cet_build_plugin)
#     dunenv rebuild NAME --clean   from scratch: mrb z, mrbsetenv, mrb i -j N
#                                   for new folders (+ add_subdirectory in the
#                                   parent CMakeLists.txt), new packages, or a
#                                   confused build folder
#   Both: build machines only (checked on the host and in the container),
#   fresh build container, mrbslp at the end, log <area>/dunenv_rebuild_*.log.
# ===========================================================================

def cmd_rebuild(cfg, args):
    if in_container():
        return fail("run 'dunenv rebuild' on the host: it opens its own build container.\n"
                    "       Already in a set-up shell on a build machine? Then: mrbsetenv; cd $MRB_BUILDDIR; make install -j20")
    if cfg.env(args.name) is None:
        return fail("no environment '{}'. Registered: {}  (dunenv list; register an area with dunenv add)"
                    .format(args.name, ", ".join(cfg.env_names()) or "none"))
    try:
        plan = make_plan(cfg, env_name=args.name, version=args.version, qualifier=args.qualifier)
        jobs, host_patterns = build_settings(cfg, args.jobs)
    except PlanError as err:
        return fail(err)

    local = plan["local"]
    mode = "rebuild-clean" if args.clean else "rebuild"
    refusal = build_host_refusal(host_patterns, jobs, ".")
    if refusal:
        if not args.dry_run:
            return fail(refusal)
        eprint("{}[dry run] the real run would stop here:{} {}".format(YELLOW, RESET, refusal))

    print("  name      : {}".format(args.name))
    print("  area      : {}".format(plan["area"]))
    print("  project   : {}  ->  {}".format(local["project"], os.path.basename(local["dir"])))
    print("  dunesw    : {} -q {}".format(plan["version"], plan["qualifier"]))
    print("  build     : {}".format("clean: mrb z, mrbsetenv, mrb i -j {}".format(jobs) if args.clean
                                    else "incremental: mrbsetenv, make install -j {}".format(jobs)))
    print("  host      : {}".format(" / ".join(host_names())))

    spec = dict(name=args.name, area=plan["area"], project=local["project"], version=plan["version"],
                qualifier=plan["qualifier"], packages=[], jobs=jobs, host_patterns=host_patterns,
                repo_url="", lp_name=os.path.basename(local["dir"]), mode=mode)
    status = run_build_container(cfg, bash_newdev_script(cfg, spec), args.dry_run)
    if args.dry_run:
        return 0
    if status != 0:
        return fail("dunenv rebuild stopped (exit {}). Log: {}/dunenv_rebuild_*.log{}".format(
            status, plan["area"], "" if args.clean else "\n       If the build folder is confused, try: dunenv rebuild {} --clean"
            .format(args.name)), status)
    print("use it:  dunenv {}".format(args.name))
    return 0


# ===========================================================================
# Block 10 - Interactive menu ("dunenv" with no arguments)
# ===========================================================================

def _ask(prompt, default=""):
    try:
        answer = input(prompt).strip()
    except EOFError:
        answer = ""
    return answer or default


def cmd_menu(cfg, args):
    names = cfg.env_names()
    default_env = cfg.get("defaults", "env", "none")
    print("\n{}dunenv{} - DUNE SL7 environment   (config: {})\n".format(BOLD, RESET, cfg.path))
    print("  {}  {:<12} {:<28} {}".format("#", "environment", "dunesw", "description"))
    rows = [("none", "{} -q {}".format(cfg.get("defaults", "version"), cfg.get("defaults", "qualifier")),
             "dunesw + packages only")]
    for name in names:
        env = cfg.env(name)
        rows.append((name, describe_products(find_local_products(_expand(env.get("area", "")))), env.get("desc", "")))
    for i, row in enumerate(rows):
        print("  {}  {:<12} {:<28} {}".format(i, *row))

    default_index = next((i for i, row in enumerate(rows) if row[0] == default_env), 0)
    choice = _ask("\nEnvironment [0-{}, Enter = {}]: ".format(len(rows) - 1, rows[default_index][0]),
                  str(default_index))
    if choice.isdigit() and int(choice) < len(rows):
        env_name = rows[int(choice)][0]
    elif choice in [row[0] for row in rows]:
        env_name = choice
    else:
        return fail("no such choice: " + choice)

    flavor = "normal"
    if not in_container():
        flavor = "build" if _ask("Container: (n)ormal or (b)uild [Enter = normal]: ", "n").lower().startswith("b") else "normal"
    grid = not _ask("Token + JUSTIN + Rucio? [Y/n]: ", "y").lower().startswith("n")

    try:
        plan = make_plan(cfg, env_name=env_name, grid=grid, flavor=flavor)
    except PlanError as err:
        return fail(err)
    print("\nSame thing next time:  {}{}{}\n".format(
        BLUE, equivalent_command(plan, default_env).replace("start", "setup" if in_container() else "start"), RESET))
    print_plan(plan)
    script = bash_setup_script(cfg, plan)
    if in_container():
        return deliver_to_shell(script, "setup " + env_name)
    return launch_container(cfg, flavor, script)


